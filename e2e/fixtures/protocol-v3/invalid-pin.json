{
  "description": "非法 pin 载荷/版本矩阵：除 envelope 非法（status=ignored）外，pin_set 失败统一 ack invalid_pin_payload，旧图案不变；pin 消息仅 v3",
  "cases": [
    {
      "name": "missing-pin",
      "expected": {
        "status": "rejected",
        "error": "invalid_pin_payload"
      },
      "message": {
        "type": "mfa_pin_set",
        "version": 3,
        "sentAt": 1760000003000
      }
    },
    {
      "name": "pin-not-object",
      "expected": {
        "status": "rejected",
        "error": "invalid_pin_payload"
      },
      "message": {
        "type": "mfa_pin_set",
        "version": 3,
        "sentAt": 1760000003000,
        "pin": "2dbc720af102c020e10d28c89e25a6a32416e87a1e26b8f10d23baa2bc9a41dc"
      }
    },
    {
      "name": "pin-null",
      "expected": {
        "status": "rejected",
        "error": "invalid_pin_payload"
      },
      "message": {
        "type": "mfa_pin_set",
        "version": 3,
        "sentAt": 1760000003000,
        "pin": null
      }
    },
    {
