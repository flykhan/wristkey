<script>
import router from "@system.router"
import { loadPin } from "./common/scripts/pinStore"
import { clearSession, shouldRelock } from "./common/scripts/pinSessionStore"

export default {
  onCreate() {
    // Cold start always asks for the pattern again. The flag covers the short
    // window before the async storage delete completes.
    this.coldStartPending = true
    clearSession(() => {
      this.coldStartPending = false
    })
  },
  onShow() {
    const state = readRouteState()
    const path = (state && (state.path || state.name)) || ""
    if (path.indexOf("/pages/lock") >= 0 || path.indexOf("/pages/pin") >= 0) {
      return
    }
    if (this.coldStartPending) {
      this.relock()
      return
    }
    shouldRelock(Date.now(), relock => {
      if (relock) {
        this.relock()
      }
    })
  },
  relock() {
    loadPin(record => {
      if (record) {
        router.replace({ uri: "/pages/lock" })
      }
    })
  },
  onDestroy() {}
}

function readRouteState() {
  try {
    return router.getState()
  } catch (error) {
    return null
  }
}
</script>
