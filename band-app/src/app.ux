<script>
import router from "@system.router"
import { loadPin } from "./common/scripts/pinStore"
import { clearSession, shouldRelock } from "./common/scripts/pinSessionStore"

export default {
  onCreate() {
    // A cold start always asks for the pattern again. The persisted session is
    // kept in two page bundles only while the app stays alive.
    clearSession(() => {})
  },
  onShow() {
    // The page navigator may still be empty during cold start. The entry page
    // (index.ux) owns the first lock decision; app.ux only re-locks when the
    // app returns to the foreground on a non-entry page.
    const state = readRouteState()
    const path = (state && (state.path || state.name)) || ""
    if (!path) {
      return
    }
    if (path.indexOf("/pages/lock") >= 0 || path.indexOf("/pages/pin") >= 0) {
      return
    }
    if (path.indexOf("/pages/index") >= 0) {
      return
    }
    loadPin(record => {
      if (!record) {
        return
      }
      shouldRelock(Date.now(), relock => {
        if (relock) {
          router.push({ uri: "/pages/lock" })
        }
      })
    })
  },
  onDestroy() {}
}

function readRouteState() {
  try {
    return router.getState()
  } catch (error) {
    return null
  }
}
</script>
