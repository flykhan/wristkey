<script>
// v2.1.2: the startup gate lives inside pages/index as a conditionally
// rendered lock view, not as a pushed route. Pushing/backing a separate lock
// page left an empty page stack on Vela ("PageNavigator getState error: empty
// stack!"), which killed the app right after the pattern was accepted. app.ux
// intentionally does nothing: index owns cold-start lock and 2 minute relock.
export default {
  onCreate() {},
  onShow() {},
  onDestroy() {}
}
</script>
