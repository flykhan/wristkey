<template>
  <div class="page" onswipe="handleSwipe" style="background-color: {{ theme.pageBackground }}">
    <div class="lock-page" if="{{ locked }}" onlongpress="clearLockInput" style="background-color: {{ theme.pageBackground }}">
      <div class="lock-top" style="margin-left: {{ lockShakeOffset }}px">
        <div class="lock-close" onclick="exitApp" style="background-color: {{ theme.buttonBackground }}">
          <text class="lock-close-text" style="color: {{ theme.secondary }}">×</text>
        </div>
        <text class="lock-title" style="color: {{ theme.title }}">腕证已锁定</text>
        <div class="lock-top-spacer"></div>
      </div>

      <div class="lock-slots" style="margin-left: {{ lockShakeOffset }}px">
        <div class="lock-slot" for="{{ lockSlots }}" style="background-color: {{ theme.itemBackground }}; border-width: {{ $item.borderWidth }}px; border-color: {{ $item.borderColor }}">
          <text class="lock-slot-glyph" if="{{ $item.filled }}" style="color: {{ $item.color }}">{{ $item.glyph }}</text>
        </div>
      </div>

      <text class="lock-hint" style="color: {{ lockHintColor }}">{{ lockHintText }}</text>

      <div class="lock-keys" style="opacity: {{ lockKeyOpacity }}; margin-left: {{ lockShakeOffset }}px">
        <div class="lock-key" for="{{ lockSymbols }}" onclick="tapLockSymbol($item.key)" style="background-color: {{ theme.cardBackground }}; border-color: {{ theme.cardBorder }}">
          <text class="lock-key-glyph" style="color: {{ $item.color }}">{{ $item.glyph }}</text>
          <text class="lock-key-label" style="color: {{ theme.secondary }}">{{ $item.label }}</text>
        </div>
      </div>
    </div>

    <div class="card" if="{{ mainVisible }}" style="background-color: {{ theme.cardBackground }}">
      <div class="list" if="{{ ready && pageAccounts.length > 0 }}">
        <div class="otp-item" for="{{ pageAccounts }}" onclick="openDetail($item.id)" style="background-color: {{ theme.itemBackground }}">
          <div class="otp-head">
            <text class="otp-issuer" style="color: {{ theme.title }}">{{ $item.issuer }}</text>
            <text class="otp-account" style="color: {{ theme.secondary }}">{{ $item.accountName }}</text>
          </div>
          <div class="otp-body">
            <text class="otp-code" style="color: {{ theme.codeColor }}; font-size: {{ $item.codeFontSize }}px">{{ $item.groupedCode }}</text>
            <text class="otp-remaining" style="color: {{ theme.secondary }}">{{ $item.remaining }}s</text>
          </div>
          <div class="otp-progress" style="background-color: {{ theme.progressTrack }}">
            <div class="otp-progress-fill" style="width: {{ $item.progress }}%; background-color: {{ $item.progressColor }}"></div>
          </div>
        </div>
      </div>

      <div class="empty" if="{{ ready && pageAccounts.length === 0 }}">
        <text class="empty-title" style="color: {{ theme.title }}">{{ emptyTitle }}</text>
        <text class="empty-copy" style="color: {{ theme.secondary }}">{{ emptyCopy }}</text>
        <div class="empty-button" onclick="requestSync" style="background-color: {{ theme.buttonBackground }}">
          <text class="empty-button-text" style="color: {{ theme.accent }}">请求手机同步</text>
        </div>
      </div>

      <div class="rail">
        <div class="letter-button" onclick="openPicker" style="background-color: {{ letterButtonBackground }}; border-width: {{ letterButtonBorderWidth }}px; border-color: {{ theme.accent }}">
          <text class="letter-text" style="color: {{ theme.accent }}">{{ filterLabel }}</text>
        </div>
        <text class="rail-count" style="color: {{ theme.secondary }}">共 {{ filteredCount }} 个</text>
        <text class="page-indicator" style="color: {{ theme.secondary }}" onclick="nextPage">{{ page + 1 }}/{{ pageCount }}</text>
        <div class="menu-button" onclick="openMenu" style="background-color: {{ theme.buttonBackground }}">
          <text class="menu-button-text" style="color: {{ theme.body }}">菜单</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { buildTokenState } from "../../common/scripts/totp"
import { sortAccountsById } from "../../common/scripts/accountModel"
import {
  applyCommittedSnapshot,
  loadSnapshot as loadStoredSnapshot,
  saveSnapshot
} from "../../common/scripts/mfaConfig"
import {
  connect,
  disconnect,
  requestSync as requestPhoneSync,
  sendAck,
  sendPinAck,
  sendPinState
} from "../../common/scripts/interconnect"
import {
  buildAck,
  buildPinAck,
  buildPinState,
  createSyncState,
  handleMessage,
  parseLegacySnapshot
} from "../../common/scripts/syncProtocol"
import { loadLock, loadPin, saveLock, savePin, deletePin } from "../../common/scripts/pinStore"
import {
  PATTERN_LENGTH,
  PATTERN_SYMBOLS,
  emptyLockState,
  formatLockCountdown,
  isLocked,
  lockRemainingMs,
  nextLockAfterFailure,
  resetLockState,
  verifyPattern
} from "../../common/scripts/pin"
import { markUnlocked, shouldRelock } from "../../common/scripts/pinSessionStore"
import {
  ACCOUNTS_PER_PAGE,
  DARK_THEME,
  DEFAULT_DARK_MODE,
  LETTER_FILTER_STORAGE_KEY,
  THEME_STORAGE_KEY,
  cyclePage,
  filterAccountsByLetter,
  listCodeFontSize,
  normalizeLetterFilter,
  paginate,
  parseDarkMode,
  progressColor,
  themeFor
} from "../../common/scripts/settings"

export default {
  private: {
    rawAccounts: [],
    page: 0,
    pageCount: 1,
    pageAccounts: [],
    filteredCount: 0,
    ready: false,
    theme: DARK_THEME,
    letterFilter: "",
    filterLabel: "A-Z",
    letterButtonBackground: DARK_THEME.buttonBackground,
    letterButtonBorderWidth: 0,
    emptyTitle: "还没有验证码",
    emptyCopy: "在手机 App 导入 Stratum 备份后同步",
    timer: null,

    // Entry gate. The lock is rendered inside this page instead of being a
    // pushed route: a pushed + backed lock page could leave an empty page stack
    // on Vela (PageNavigator getState error: empty stack!), which killed the
    // app right after the pattern was accepted.
    locked: false,
    mainVisible: false,
    gateReady: false,
    gateEvaluating: false,
    coldStart: true,
    pageShown: false,
    pin: null,
    lock: emptyLockState(),
    lockSymbols: PATTERN_SYMBOLS,
    lockInput: [],
    lockSlots: [],
    lockHintText: "按顺序点击 5 个图形",
    lockHintColor: DARK_THEME.secondary,
    lockKeyOpacity: 1,
    lockShakeOffset: 0,
    lockVerifying: false
  },

  onInit() {
    this.syncState = createSyncState()
    this.channelReady = false
    this.locked = false
    this.mainVisible = false
    this.gateReady = false
    this.gateEvaluating = false
    this.coldStart = true
    this.pageShown = false
    this.loadTheme()
    this.loadLetterFilter()
    this.loadGate()
  },

  onShow() {
    this.pageShown = true
    this.loadTheme()
    this.loadLetterFilter()
    if (this.gateReady) {
      this.evaluateGate()
    }
  },

  onHide() {
    this.stopTicker()
  },

  onDestroy() {
    this.stopTicker()
    disconnect()
  },

  /* ---------------------------------------------------------------- gate */

  loadGate() {
    loadPin(record => {
      this.pin = record
      loadLock(lock => {
        this.lock = lock
        this.gateReady = true
        if (this.pageShown) {
          this.evaluateGate()
        }
      })
    })
  },

  evaluateGate() {
    if (!this.gateReady || this.gateEvaluating) {
      return
    }
    if (!this.pin) {
      // No pattern configured: the app is open by design.
      this.unlockGate(false)
      return
    }
    if (this.locked) {
      // The lock screen is already up. Never auto-unlock here: only a
      // verified pattern (verifyLock) may clear this.locked flag.
      return
    }
    if (this.coldStart) {
      this.coldStart = false
      this.showLock()
      return
    }
    this.gateEvaluating = true
    shouldRelock(Date.now(), relock => {
      this.gateEvaluating = false
      if (relock) {
        this.showLock()
        return
      }
      this.enterMain()
    })
  },

  showLock() {
    this.locked = true
    this.mainVisible = false
    this.stopTicker()
    this.refreshLockView()
    this.startTicker()
  },

  unlockGate(persist) {
    this.locked = false
    this.mainVisible = true
    this.lockInput = []
    this.lockVerifying = false
    this.lockHintText = "按顺序点击 5 个图形"
    this.lockHintColor = this.theme.secondary
    if (persist) {
      markUnlocked(Date.now(), function () {})
    }
    this.enterMain()
  },

  enterMain() {
    this.loadSnapshot()
    if (!this.channelReady) {
      this.setupChannel()
    }
    this.startTicker()
  },

  refreshLockView() {
    if (!this.locked) {
      return
    }
    const now = Date.now()
    const lockedOut = isLocked(this.lock, now)
    this.lockKeyOpacity = lockedOut ? 0.4 : 1
    this.refreshLockSlots()
    if (lockedOut) {
      this.lockHintText = "错误次数过多 · " + formatLockCountdown(lockRemainingMs(this.lock, now))
      this.lockHintColor = this.theme.progressDanger
      return
    }
    if (this.lockVerifying) {
      this.lockHintText = "正在校验…"
      this.lockHintColor = this.theme.secondary
      return
    }
    if (this.lockInput.length === 0) {
      this.lockHintText = "按顺序点击 5 个图形"
      this.lockHintColor = this.theme.secondary
    }
  },

  refreshLockSlots() {
    const chosen = []
    for (let index = 0; index < this.lockInput.length; index++) {
      const key = this.lockInput[index]
      for (let symbol = 0; symbol < PATTERN_SYMBOLS.length; symbol++) {
        if (PATTERN_SYMBOLS[symbol].key === key) {
          chosen.push(PATTERN_SYMBOLS[symbol])
          break
        }
      }
    }
    const slots = []
    for (let index = 0; index < PATTERN_LENGTH; index++) {
      const symbol = chosen[index]
      const active = !symbol && index === this.lockInput.length && !isLocked(this.lock, Date.now())
      slots.push({
        filled: !!symbol,
        glyph: symbol ? symbol.glyph : "",
        color: symbol ? symbol.color : this.theme.secondary,
        borderWidth: active ? 2 : 0,
        borderColor: active ? this.theme.accent : "transparent"
      })
    }
    this.lockSlots = slots
  },

  tapLockSymbol(key) {
    if (!this.locked || this.lockVerifying || isLocked(this.lock, Date.now())) {
      return
    }
    if (this.lockInput.length >= PATTERN_LENGTH) {
      return
    }
    this.lockInput = this.lockInput.concat([key])
    this.refreshLockSlots()
    if (this.lockInput.length === PATTERN_LENGTH) {
      this.lockVerifying = true
      this.lockHintText = "正在校验…"
      this.lockHintColor = this.theme.secondary
      // Give the framework one frame to paint the progress hint before the
      // pure-JS PBKDF2 derivation runs on the same thread.
      setTimeout(() => {
        this.verifyLock()
      }, 40)
    }
  },

  verifyLock() {
    const pattern = this.lockInput.join("")
    const result = verifyPattern(pattern, this.pin)
    if (result.ok && result.matched) {
      this.lock = resetLockState(Date.now())
      saveLock(this.lock)
      this.lockInput = []
      this.lockVerifying = false
      this.unlockGate(true)
      return
    }
    this.handleLockFailure()
  },

  handleLockFailure() {
    this.lock = nextLockAfterFailure(this.lock, Date.now())
    saveLock(this.lock)
    this.lockInput = []
    this.lockVerifying = false
    this.refreshLockSlots()
    this.shakeLock()
    if (isLocked(this.lock, Date.now())) {
      this.refreshLockView()
    } else {
      this.lockHintText = "图案不正确，请重试"
      this.lockHintColor = this.theme.progressDanger
    }
  },

  shakeLock() {
    const offsets = [7, -7, 5, -5, 0]
    for (let index = 0; index < offsets.length; index++) {
      setTimeout(() => {
        this.lockShakeOffset = offsets[index]
      }, index * 55)
    }
  },

  clearLockInput() {
    if (!this.locked || isLocked(this.lock, Date.now())) {
      return
    }
    this.lockInput = []
    this.lockVerifying = false
    this.lockHintText = "已清空，请重新输入"
    this.lockHintColor = this.theme.secondary
    this.refreshLockSlots()
  },

  exitApp() {
    this.$app.exit()
  },

  /* ---------------------------------------------------------------- data */

  loadTheme() {
    storage.get({
      key: THEME_STORAGE_KEY,
      default: DEFAULT_DARK_MODE ? "true" : "false",
      success: value => {
        this.applyTheme(parseDarkMode(value))
      },
      fail: () => {
        this.applyTheme(DEFAULT_DARK_MODE)
      }
    })
  },

  applyTheme(isDark) {
    this.theme = themeFor(isDark)
    this.refreshFilterState()
    this.refreshList()
    if (this.locked) {
      this.refreshLockView()
    }
  },

  loadLetterFilter() {
    storage.get({
      key: LETTER_FILTER_STORAGE_KEY,
      default: "",
      success: value => {
        this.letterFilter = normalizeLetterFilter(value)
        this.refreshFilterState()
        this.refreshList()
      },
      fail: () => {
        this.letterFilter = ""
        this.refreshFilterState()
        this.refreshList()
      }
    })
  },

  loadSnapshot() {
    loadStoredSnapshot(snapshot => {
      this.rawAccounts = sortAccountsById(snapshot.accounts)
      this.ready = true
      this.refreshList()
    })
  },

  refreshFilterState() {
    this.filterLabel = this.letterFilter || "A-Z"
    this.letterButtonBackground = this.letterFilter
      ? this.theme.accentSoft
      : this.theme.buttonBackground
    this.letterButtonBorderWidth = this.letterFilter ? 2 : 0
  },

  refreshList() {
    const filtered = filterAccountsByLetter(this.rawAccounts, this.letterFilter)
    const pageData = paginate(filtered, this.page, ACCOUNTS_PER_PAGE)
    this.page = pageData.page
    this.pageCount = pageData.pageCount
    this.filteredCount = filtered.length

    const now = Date.now()
    const tokens = []
    for (let index = 0; index < pageData.items.length; index++) {
      const account = pageData.items[index]
      const token = buildTokenState(account, now)
      tokens.push({
        id: token.id,
        issuer: token.issuer || "未命名",
        accountName: token.accountName,
        groupedCode: token.groupedCode,
        codeFontSize: listCodeFontSize(token.groupedCode),
        remaining: token.remaining,
        progress: token.progress,
        progressColor: progressColor(token.remaining, this.theme)
      })
    }
    this.pageAccounts = tokens

    if (this.rawAccounts.length === 0) {
      this.emptyTitle = "还没有验证码"
      this.emptyCopy = "在手机 App 导入 Stratum 备份后同步"
    } else if (filtered.length === 0) {
      this.emptyTitle = "该首字母下暂无账号"
      this.emptyCopy = "点击右侧 " + this.filterLabel + " 切换筛选"
    }
  },

  /* ---------------------------------------------------------------- sync */

  setupChannel() {
    if (this.channelReady) {
      return
    }
    this.channelReady = true
    connect({
      onMessage: message => {
        this.handleChannelMessage(message)
      }
    })
  },

  handleChannelMessage(message) {
    const legacy = parseLegacySnapshot(message)
    if (legacy) {
      saveSnapshot(legacy, result => {
        if (!result.ok) {
          return
        }
        this.rawAccounts = sortAccountsById(legacy.accounts)
        this.page = 0
        this.refreshList()
      })
      return
    }

    const result = handleMessage(this.syncState, message, Date.now(), {
      previousAccounts: this.rawAccounts
    })
    this.syncState = result.state

    if (result.pinCommand) {
      this.applyPinCommand(result.pinCommand)
      return
    }
    if (!result.committed) {
      if (result.ack) {
        sendAck(result.ack)
      }
      return
    }
    applyCommittedSnapshot(result.committed, saveResult => {
      if (saveResult.ok) {
        this.rawAccounts = sortAccountsById(result.committed.accounts)
        this.page = 0
        this.refreshList()
        sendAck(result.ack)
        return
      }
      // Persisting failed: old snapshot is untouched, tell the phone the truth.
      sendAck(
        buildAck({
          syncId: result.ack.syncId,
          ok: false,
          received: result.ack.received,
          committed: 0,
          error: "storage_write_failed",
          sentAt: Date.now()
        })
      )
    })
  },

  applyPinCommand(command) {
    const sentAt = Date.now()
    if (command.type === "set" && command.record) {
      savePin(command.record, result => {
        if (!result.ok) {
          sendPinAck(buildPinAck({ ok: false, error: "storage_error", sentAt: sentAt }))
          return
        }
        this.pin = command.record
        this.lock = resetLockState(sentAt)
        saveLock(this.lock)
        sendPinAck(buildPinAck({ ok: true, enabled: true, sentAt: sentAt }))
        sendPinState(buildPinState(command.record, { sentAt: sentAt }))
        if (this.gateReady) {
          this.showLock()
        }
      })
      return
    }
    if (command.type === "query") {
      loadPin(record => {
        sendPinState(
          buildPinState(record, { sentAt: sentAt, requestId: command.requestId })
        )
      })
      return
    }
    if (command.type === "clear") {
      deletePin(result => {
        if (!result.ok) {
          sendPinAck(buildPinAck({ ok: false, error: "storage_error", sentAt: sentAt }))
          return
        }
        this.pin = null
        this.lock = resetLockState(sentAt)
        saveLock(this.lock)
        sendPinAck(buildPinAck({ ok: true, enabled: false, sentAt: sentAt }))
        sendPinState(buildPinState(null, { sentAt: sentAt }))
        if (this.locked) {
          this.unlockGate(false)
        }
      })
    }
  },

  requestSync() {
    requestPhoneSync(function () {})
  },

  /* ---------------------------------------------------------------- ticker */

  startTicker() {
    if (this.timer) {
      return
    }
    this.timer = setInterval(() => {
      if (this.locked) {
        this.refreshLockView()
      } else {
        this.refreshList()
      }
    }, 1000)
  },

  stopTicker() {
    if (!this.timer) {
      return
    }
    clearInterval(this.timer)
    this.timer = null
  },

  /* ---------------------------------------------------------------- ui */

  openDetail(id) {
    router.push({
      uri: "/pages/detail",
      params: { id: id }
    })
  },

  openPicker() {
    router.push({ uri: "/pages/picker" })
  },

  openMenu() {
    router.push({ uri: "/pages/menu" })
  },

  nextPage() {
    if (this.pageCount <= 1) {
      return
    }
    this.page = cyclePage(this.page, this.pageCount, 1)
    this.refreshList()
  },

  previousPage() {
    if (this.pageCount <= 1) {
      return
    }
    this.page = cyclePage(this.page, this.pageCount, -1)
    this.refreshList()
  },

  handleSwipe(event) {
    if (!event || !event.direction) {
      return
    }
    if (this.locked) {
      if (event.direction === "left") {
        this.exitApp()
      }
      return
    }
    if (event.direction === "up") {
      this.nextPage()
    } else if (event.direction === "down") {
      this.previousPage()
    } else if (event.direction === "right") {
      this.openMenu()
    } else if (event.direction === "left") {
      this.$app.exit()
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding: 8px;
  flex-direction: column;
  background-color: #000000;
}

.card {
  width: 100%;
  height: 100%;
  padding: 8px;
  flex-direction: row;
  border-radius: 22px;
  background-color: #0b0f0e;
}

.list {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

.otp-item {
  flex: 1;
  width: 100%;
  margin-bottom: 6px;
  padding: 4px 10px 6px;
  border-radius: 14px;
  flex-direction: column;
  justify-content: space-between;
}

.otp-head {
  width: 100%;
  flex-direction: row;
  align-items: flex-end;
}

.otp-issuer {
  max-width: 68%;
  font-size: 21px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.otp-account {
  flex: 1;
  margin-left: 6px;
  font-size: 13px;
  lines: 1;
  text-overflow: ellipsis;
}

.otp-body {
  width: 100%;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

.otp-code {
  font-weight: bold;
  text-align: left;
  lines: 1;
  text-overflow: clip;
}

.otp-remaining {
  margin-left: 8px;
  font-size: 14px;
  text-align: right;
  lines: 1;
}

.otp-progress {
  width: 100%;
  height: 3px;
  margin-top: 3px;
  border-radius: 2px;
}

.otp-progress-fill {
  height: 3px;
  border-radius: 2px;
  transition-property: width;
  transition-duration: 1000ms;
  transition-timing-function: linear;
}

.rail {
  width: 56px;
  height: 100%;
  margin-left: 6px;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.letter-button {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  align-items: center;
  justify-content: center;
}

.letter-text {
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.rail-count {
  margin-top: 2px;
  font-size: 11px;
  text-align: center;
  lines: 1;
}

.page-indicator {
  margin-top: 2px;
  font-size: 13px;
  text-align: center;
  lines: 1;
}

.menu-button {
  width: 44px;
  height: 34px;
  margin-bottom: 4px;
  border-radius: 14px;
  align-items: center;
  justify-content: center;
}

.menu-button-text {
  font-size: 13px;
  text-align: center;
  lines: 1;
}

.empty {
  flex: 1;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 22px;
  font-weight: bold;
  text-align: center;
}

.empty-copy {
  margin-top: 6px;
  font-size: 14px;
  text-align: center;
  lines: 2;
}

.empty-button {
  width: 180px;
  height: 32px;
  margin-top: 14px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
}

.empty-button-text {
  font-size: 15px;
  font-weight: bold;
}

/* ------------------------------------------------------------ entry lock */

.lock-page {
  width: 100%;
  height: 100%;
  padding: 0 10px 2px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.lock-top {
  width: 100%;
  height: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.lock-close {
  width: 34px;
  height: 34px;
  border-radius: 17px;
  align-items: center;
  justify-content: center;
}

.lock-close-text {
  font-size: 22px;
  font-weight: bold;
  text-align: center;
}

.lock-title {
  font-size: 19px;
  font-weight: bold;
  text-align: center;
}

