<template>
  <div class="page" onswipe="handleSwipe" style="background-color: {{ theme.pageBackground }}">
    <div class="header">
      <text class="title" style="color: {{ theme.title }}">菜单</text>
      <text class="subtitle" style="color: {{ theme.secondary }}">腕证 · WristKey</text>
    </div>

    <div class="options">
      <div class="option" onclick="openPin" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">入口密码</text>
        <text class="option-value" style="color: {{ theme.secondary }}">{{ pinLabel }}</text>
      </div>
      <div class="option" onclick="requestSync" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">立即同步</text>
        <text class="option-value" style="color: {{ theme.secondary }}">{{ requestLabel }}</text>
      </div>
      <div class="option" onclick="openCopyright" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">关于</text>
        <text class="option-value" style="color: {{ theme.secondary }}">版本 2.0.0 · Apache-2.0</text>
      </div>
      <div class="option" onclick="exitApp" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title exit-text" style="color: {{ theme.progressDanger }}">退出应用</text>
        <text class="option-value" style="color: {{ theme.progressDanger }}">关闭腕证</text>
      </div>
    </div>

    <text class="hint" style="color: {{ theme.secondary }}">右滑返回</text>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { requestSync as requestPhoneSync } from "../../common/scripts/interconnect"
import { loadPin } from "../../common/scripts/pinStore"
import {
  DARK_THEME,
  DEFAULT_DARK_MODE,
  THEME_STORAGE_KEY,
  parseDarkMode,
  themeFor
} from "../../common/scripts/settings"

export default {
  private: {
    theme: DARK_THEME,
    pinLabel: "未开启",
    requestLabel: "推送到手环",
    requestTimer: null
  },

  onInit() {
    this.loadSettings()
  },

  onShow() {
    this.loadSettings()
  },

  onHide() {
    this.clearTimer()
  },

  onDestroy() {
    this.clearTimer()
  },

  loadSettings() {
    storage.get({
      key: THEME_STORAGE_KEY,
      default: DEFAULT_DARK_MODE ? "true" : "false",
      success: value => {
        this.theme = themeFor(parseDarkMode(value))
      },
      fail: () => {
        this.theme = themeFor(DEFAULT_DARK_MODE)
      }
    })
    loadPin(record => {
      this.pinLabel = record ? "已开启 · 5 位图形" : "未开启"
    })
  },

  requestSync() {
    this.requestLabel = "请求中…"
    const handed = requestPhoneSync(result => {
      this.requestLabel = result.ok ? "已请求手机推送" : "未连接手机"
      this.scheduleRequestReset()
    })
    if (!handed) {
      this.requestLabel = "未连接手机"
      this.scheduleRequestReset()
    }
  },

  scheduleRequestReset() {
    this.clearTimer()
    this.requestTimer = setTimeout(() => {
      this.requestTimer = null
      this.requestLabel = "推送到手环"
    }, 3000)
  },

  clearTimer() {
    if (this.requestTimer) {
      clearTimeout(this.requestTimer)
      this.requestTimer = null
    }
  },

  openPin() {
    router.push({ uri: "/pages/pin" })
  },

  openCopyright() {
    router.push({ uri: "/pages/copyright" })
  },

  exitApp() {
    this.$app.exit()
  },

  handleSwipe(event) {
    if (!event || !event.direction) {
      return
    }
    if (event.direction === "right") {
      router.back()
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding: 10px 14px 6px;
  flex-direction: column;
  background-color: #000000;
}

.header {
  width: 100%;
  height: 40px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}

.subtitle {
  margin-top: 1px;
  font-size: 12px;
  text-align: center;
}

.options {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: center;
}

.option {
  flex: 1;
  width: 100%;
  margin-top: 6px;
  padding: 6px 14px;
  border-radius: 14px;
  flex-direction: column;
  justify-content: center;
}

.option-title {
  font-size: 18px;
  font-weight: bold;
  lines: 1;
}

.option-value {
  margin-top: 2px;
  font-size: 12px;
  lines: 1;
  text-overflow: ellipsis;
}

.exit-text {
  font-size: 18px;
  font-weight: bold;
}

.hint {
  height: 16px;
  font-size: 12px;
  text-align: center;
}
</style>
