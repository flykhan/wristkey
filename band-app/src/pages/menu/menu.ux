<template>
  <div class="page" onswipe="handleSwipe" style="background-color: {{ theme.pageBackground }}">
    <div class="header">
      <text class="title" style="color: {{ theme.title }}">菜单</text>
      <text class="subtitle" style="color: {{ theme.secondary }}">腕证 · WristKey</text>
    </div>

    <div class="options">
      <div class="option" onclick="openCategory" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">分类</text>
        <text class="option-value" style="color: {{ theme.secondary }}">{{ currentCategory }}</text>
      </div>
      <div class="option" onclick="toggleTheme" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">显示模式</text>
        <text class="option-value" style="color: {{ theme.secondary }}">{{ themeAction }}</text>
      </div>
      <div class="option" onclick="requestSync" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">请求手机同步</text>
        <text class="option-value" style="color: {{ theme.secondary }}">{{ requestLabel }}</text>
      </div>
      <div class="option" onclick="openCopyright" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title" style="color: {{ theme.title }}">版权与许可</text>
        <text class="option-value" style="color: {{ theme.secondary }}">Apache-2.0</text>
      </div>
      <div class="option" onclick="exitApp" style="background-color: {{ theme.cardBackground }}">
        <text class="option-title exit-text" style="color: {{ theme.progressDanger }}">退出应用</text>
        <text class="option-value" style="color: {{ theme.progressDanger }}">关闭腕证</text>
      </div>
    </div>

    <text class="hint" style="color: {{ theme.secondary }}">右滑返回</text>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { DEFAULT_CATEGORY } from "../../common/scripts/accountModel"
import { requestSync as requestPhoneSync } from "../../common/scripts/interconnect"
import {
  CATEGORY_STORAGE_KEY,
  DARK_THEME,
  DEFAULT_DARK_MODE,
  THEME_STORAGE_KEY,
  parseDarkMode,
  themeFor
} from "../../common/scripts/settings"

export default {
  private: {
    currentCategory: DEFAULT_CATEGORY,
    isDark: DEFAULT_DARK_MODE,
    theme: DARK_THEME,
    themeAction: "深色",
    requestLabel: "推送到手环",
    requestTimer: null,
    themeTimer: null
  },

  onInit() {
    this.loadSettings()
  },

  onShow() {
    this.loadSettings()
  },

  onHide() {
    this.clearTimers()
  },

  onDestroy() {
    this.clearTimers()
  },

  loadSettings() {
    storage.get({
      key: THEME_STORAGE_KEY,
      default: DEFAULT_DARK_MODE ? "true" : "false",
      success: value => {
        this.applyTheme(parseDarkMode(value))
      },
      fail: () => {
        this.applyTheme(DEFAULT_DARK_MODE)
      }
    })
    storage.get({
      key: CATEGORY_STORAGE_KEY,
      default: DEFAULT_CATEGORY,
      success: value => {
        this.currentCategory = value || DEFAULT_CATEGORY
      },
      fail: () => {
        this.currentCategory = DEFAULT_CATEGORY
      }
    })
  },

  applyTheme(isDark) {
    this.isDark = isDark
    this.theme = themeFor(isDark)
    this.themeAction = isDark ? "深色（点击切换浅色）" : "浅色（点击切换深色）"
  },

  toggleTheme() {
    const next = !this.isDark
    this.applyTheme(next)
    storage.set({
      key: THEME_STORAGE_KEY,
      value: next ? "true" : "false"
    })
  },

  requestSync() {
    this.requestLabel = "请求中…"
    const handed = requestPhoneSync(result => {
      this.requestLabel = result.ok ? "已请求手机推送" : "未连接手机"
      this.scheduleRequestReset()
    })
    if (!handed) {
      this.requestLabel = "未连接手机"
      this.scheduleRequestReset()
    }
  },

  scheduleRequestReset() {
    if (this.requestTimer) {
      clearTimeout(this.requestTimer)
    }
    this.requestTimer = setTimeout(() => {
      this.requestTimer = null
      this.requestLabel = "推送到手环"
    }, 3000)
  },

  openCategory() {
    router.push({ uri: "/pages/category" })
  },

  openCopyright() {
    router.push({ uri: "/pages/copyright" })
  },

  exitApp() {
    this.$app.exit()
  },

  clearTimers() {
    if (this.requestTimer) {
      clearTimeout(this.requestTimer)
      this.requestTimer = null
    }
    if (this.themeTimer) {
      clearTimeout(this.themeTimer)
      this.themeTimer = null
    }
  },

  handleSwipe(event) {
    if (!event || !event.direction) {
      return
    }
    if (event.direction === "right") {
      router.back()
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding: 10px 14px 6px;
  flex-direction: column;
  background-color: #000000;
}

.header {
  width: 100%;
  height: 40px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}

.subtitle {
  margin-top: 1px;
  font-size: 12px;
  text-align: center;
}

.options {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: center;
}

.option {
  flex: 1;
  width: 100%;
  margin-top: 4px;
  padding: 4px 14px;
  border-radius: 14px;
  flex-direction: column;
  justify-content: center;
}

.option-title {
  font-size: 17px;
  font-weight: bold;
  lines: 1;
}

.option-value {
  margin-top: 1px;
  font-size: 12px;
  lines: 1;
  text-overflow: ellipsis;
}

.exit-text {
  font-size: 17px;
  font-weight: bold;
}

.hint {
  height: 16px;
  font-size: 12px;
  text-align: center;
}
</style>
