<template>
  <div class="page" onswipe="handleSwipe" style="background-color: {{ theme.pageBackground }}">
    <div class="card" style="background-color: {{ theme.cardBackground }}">
      <text class="title" style="color: {{ theme.title }}">按首字母筛选</text>
      <text class="hint" style="color: {{ theme.secondary }}">有账号的首字母高亮，右滑取消</text>

      <div class="grid">
        <div class="grid-row">
          <div class="cell" for="{{ row0 }}" onclick="selectLetter($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ theme.accent }}">
            <text class="cell-letter" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.showCount }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row1 }}" onclick="selectLetter($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ theme.accent }}">
            <text class="cell-letter" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.showCount }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row2 }}" onclick="selectLetter($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ theme.accent }}">
            <text class="cell-letter" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.showCount }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row3 }}" onclick="selectLetter($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ theme.accent }}">
            <text class="cell-letter" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.showCount }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row4 }}" onclick="selectLetter($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ theme.accent }}">
            <text class="cell-letter" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.showCount }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row5 }}" onclick="selectLetter($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ theme.accent }}">
            <text class="cell-letter" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.showCount }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { loadSnapshot } from "../../common/scripts/mfaConfig"
import {
  DARK_THEME,
  DEFAULT_DARK_MODE,
  LETTER_FILTER_STORAGE_KEY,
  LETTER_KEYS,
  THEME_STORAGE_KEY,
  buildLetterCounts,
  normalizeLetterFilter,
  parseDarkMode,
  themeFor
} from "../../common/scripts/settings"

const COLUMNS = 7
const ROWS = 6

export default {
  private: {
    theme: DARK_THEME,
    accounts: [],
    letterCounts: {},
    currentFilter: "",
    row0: [],
    row1: [],
    row2: [],
    row3: [],
    row4: [],
    row5: []
  },

  onInit() {
    this.loadTheme()
    this.loadAccounts()
  },

  onShow() {
    this.loadTheme()
    this.loadAccounts()
  },

  loadTheme() {
    storage.get({
      key: THEME_STORAGE_KEY,
      default: DEFAULT_DARK_MODE ? "true" : "false",
      success: value => {
        this.theme = themeFor(parseDarkMode(value))
        this.buildRows()
      },
      fail: () => {
        this.theme = themeFor(DEFAULT_DARK_MODE)
        this.buildRows()
      }
    })
  },

  loadAccounts() {
    storage.get({
      key: LETTER_FILTER_STORAGE_KEY,
      default: "",
      success: value => {
        this.currentFilter = normalizeLetterFilter(value)
        this.loadFromSnapshot()
      },
      fail: () => {
        this.currentFilter = ""
        this.loadFromSnapshot()
      }
    })
  },

  loadFromSnapshot() {
    loadSnapshot(snapshot => {
      this.accounts = snapshot.accounts
      this.letterCounts = buildLetterCounts(this.accounts)
      this.buildRows()
    })
  },

  buildRows() {
    const cells = []
    for (let index = 0; index < LETTER_KEYS.length; index++) {
      const key = LETTER_KEYS[index]
      cells.push(this.buildCell(key, key))
    }
    cells.push(this.buildCell("ALL", "全部"))
    cells.push(this.buildCell("#", "#"))

    const rows = []
    let row = []
    for (let index = 0; index < cells.length; index++) {
      row.push(cells[index])
      if (row.length === COLUMNS) {
        rows.push(row)
        row = []
      }
    }
    if (row.length > 0) {
      while (row.length < COLUMNS) {
        row.push(this.buildPlaceholder())
      }
      rows.push(row)
    }
    while (rows.length < ROWS) {
      const blanks = []
      for (let column = 0; column < COLUMNS; column++) {
        blanks.push(this.buildPlaceholder())
      }
      rows.push(blanks)
    }

    this.row0 = rows[0]
    this.row1 = rows[1]
    this.row2 = rows[2]
    this.row3 = rows[3]
    this.row4 = rows[4]
    this.row5 = rows[5]
  },

  buildCell(key, label) {
    const counts = this.letterCounts || {}
    const count = key === "ALL" ? this.accounts.length : (counts[key] || 0)
    const active = key === "ALL" ? this.accounts.length > 0 : count > 0
    const selected = key === "ALL" ? this.currentFilter === "" : this.currentFilter === key
    return {
      key: key,
      label: String(label),
      background: active ? this.theme.accentSoft : this.theme.itemBackground,
      textColor: active ? this.theme.accent : this.theme.disabledText,
      borderWidth: selected ? 2 : 0,
      showCount: active && count > 0,
      countText: String(count),
      countColor: active ? this.theme.secondary : this.theme.disabledText
    }
  },

  buildPlaceholder() {
    return {
      key: "",
      label: "",
      background: "transparent",
      textColor: "transparent",
      borderWidth: 0,
      showCount: false,
      countText: "",
      countColor: "transparent"
    }
  },

  selectLetter(key) {
    if (!key) {
      return
    }
    let value = key
    if (key === "ALL") {
      value = ""
    } else if (!this.letterCounts[key]) {
      // Grey cells (no accounts) are not selectable.
      return
    }
    storage.set({
      key: LETTER_FILTER_STORAGE_KEY,
      value: value,
      success: () => {
        router.back()
      },
      fail: () => {
        router.back()
      }
    })
  },

  handleSwipe(event) {
    if (!event || !event.direction) {
      return
    }
    if (event.direction === "right") {
      router.back()
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding: 8px;
  flex-direction: column;
  background-color: #000000;
}

.card {
  width: 100%;
  height: 100%;
  padding: 12px 14px;
  flex-direction: column;
  border-radius: 22px;
  background-color: #0b0f0e;
}

.title {
  font-size: 20px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.hint {
  margin-top: 3px;
  font-size: 11px;
  lines: 1;
  text-overflow: ellipsis;
}

.grid {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: center;
}

.grid-row {
  width: 100%;
  margin-top: 5px;
  flex-direction: row;
  justify-content: space-between;
}

.cell {
  width: 57px;
  height: 33px;
  border-radius: 10px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cell-letter {
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.cell-count {
  font-size: 9px;
  text-align: center;
  lines: 1;
}
</style>
