<template>
  <div class="page" onswipe="handleSwipe" style="background-color: {{ theme.pageBackground }}">
    <div class="card" style="background-color: {{ theme.cardBackground }}">
      <div class="header">
        <text class="title" style="color: {{ theme.title }}">按首字母筛选</text>
        <text class="hint" style="color: {{ theme.secondary }}">上下滑动翻页</text>
        <div class="close" onclick="goBack" style="background-color: {{ theme.buttonBackground }}">
          <text class="close-text" style="color: {{ theme.secondary }}">×</text>
        </div>
      </div>

      <div class="grid">
        <div class="grid-row">
          <div class="cell" for="{{ row0 }}" onclick="selectCell($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ $item.borderColor }}">
            <text class="cell-letter" if="{{ !$item.placeholder }}" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.countText !== '' }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row1 }}" onclick="selectCell($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ $item.borderColor }}">
            <text class="cell-letter" if="{{ !$item.placeholder }}" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.countText !== '' }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row2 }}" onclick="selectCell($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ $item.borderColor }}">
            <text class="cell-letter" if="{{ !$item.placeholder }}" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.countText !== '' }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
        <div class="grid-row">
          <div class="cell" for="{{ row3 }}" onclick="selectCell($item.key)" style="background-color: {{ $item.background }}; border-width: {{ $item.borderWidth }}px; border-color: {{ $item.borderColor }}">
            <text class="cell-letter" if="{{ !$item.placeholder }}" style="color: {{ $item.textColor }}">{{ $item.label }}</text>
            <text class="cell-count" if="{{ $item.countText !== '' }}" style="color: {{ $item.countColor }}">{{ $item.countText }}</text>
          </div>
        </div>
      </div>

      <div class="dots">
        <div class="dot" for="{{ dots }}" style="background-color: {{ $item.color }}"></div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { loadSnapshot } from "../../common/scripts/mfaConfig"
import {
  DARK_THEME,
  DEFAULT_DARK_MODE,
  LETTER_FILTER_STORAGE_KEY,
  PICKER_COLUMNS,
  PICKER_PAGE_COUNT,
  THEME_STORAGE_KEY,
  buildPickerPage,
  normalizeLetterFilter,
  parseDarkMode,
  themeFor
} from "../../common/scripts/settings"

export default {
  private: {
    theme: DARK_THEME,
    accounts: [],
    currentFilter: "",
    pageIndex: 0,
    row0: [],
    row1: [],
    row2: [],
    row3: [],
    dots: []
  },

  onInit() {
    this.loadTheme()
    this.loadState()
  },

  onShow() {
    this.loadState()
  },

  loadTheme() {
    storage.get({
      key: THEME_STORAGE_KEY,
      default: DEFAULT_DARK_MODE ? "true" : "false",
      success: value => {
        this.theme = themeFor(parseDarkMode(value))
        this.rebuild()
      },
      fail: () => {
        this.theme = themeFor(DEFAULT_DARK_MODE)
        this.rebuild()
      }
    })
  },

  loadState() {
    storage.get({
      key: LETTER_FILTER_STORAGE_KEY,
      default: "",
      success: value => {
        this.currentFilter = normalizeLetterFilter(value)
        this.loadAccounts()
      },
      fail: () => {
        this.currentFilter = ""
        this.loadAccounts()
      }
    })
  },

  loadAccounts() {
    loadSnapshot(snapshot => {
      this.accounts = snapshot.accounts
      this.pageIndex = pageOfFilter(this.currentFilter)
      this.rebuild()
    })
  },

  rebuild() {
    const cells = buildPickerPage(this.accounts, this.currentFilter, this.theme, this.pageIndex)
    this.row0 = cells.slice(0, PICKER_COLUMNS)
    this.row1 = cells.slice(PICKER_COLUMNS, PICKER_COLUMNS * 2)
    this.row2 = cells.slice(PICKER_COLUMNS * 2, PICKER_COLUMNS * 3)
    this.row3 = cells.slice(PICKER_COLUMNS * 3, PICKER_COLUMNS * 4)
    const dots = []
    for (let index = 0; index < PICKER_PAGE_COUNT; index++) {
      dots.push({
        index: index,
        color: index === this.pageIndex ? this.theme.accent : this.theme.progressTrack
      })
    }
    this.dots = dots
  },

  nextPage() {
    if (this.pageIndex >= PICKER_PAGE_COUNT - 1) {
      return
    }
    this.pageIndex += 1
    this.rebuild()
  },

  previousPage() {
    if (this.pageIndex <= 0) {
      return
    }
    this.pageIndex -= 1
    this.rebuild()
  },

  selectCell(key) {
    if (!key) {
      return
    }
    const value = key === "ALL" ? "" : key
    storage.set({
      key: LETTER_FILTER_STORAGE_KEY,
      value: value,
      success: () => {
        router.back()
      },
      fail: () => {
        router.back()
      }
    })
  },

  goBack() {
    router.back()
  },

  handleSwipe(event) {
    if (!event || !event.direction) {
      return
    }
    if (event.direction === "up") {
      this.nextPage()
    } else if (event.direction === "down") {
      this.previousPage()
    } else if (event.direction === "right") {
      router.back()
    }
  }
}

function pageOfFilter(filter) {
  const value = normalizeLetterFilter(filter)
  if (!value) {
    return 2
  }
  if (value >= "A" && value <= "P") {
    return 0
  }
  if (value === "#" || (value >= "6" && value <= "9")) {
    return 2
  }
  return 1
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding: 6px;
  flex-direction: column;
  background-color: #000000;
}

.card {
  width: 100%;
  height: 100%;
  padding: 8px 12px;
  flex-direction: column;
  border-radius: 22px;
  background-color: #0b0f0e;
}

.header {
  width: 100%;
  height: 34px;
  flex-direction: row;
  align-items: center;
}

.title {
  font-size: 19px;
  font-weight: bold;
  lines: 1;
}

.hint {
  flex: 1;
  margin-left: 10px;
  font-size: 11px;
  lines: 1;
}

.close {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  align-items: center;
  justify-content: center;
}

.close-text {
  font-size: 20px;
  font-weight: bold;
}

.grid {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.grid-row {
  flex: 1;
  width: 100%;
  flex-direction: row;
  align-items: stretch;
}

.cell {
  flex: 1;
  margin: 3px;
  border-radius: 14px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cell-letter {
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.cell-count {
  margin-top: 1px;
  font-size: 10px;
  text-align: center;
  lines: 1;
}

.dots {
  width: 100%;
  height: 16px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 6px;
  height: 6px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 3px;
}
</style>
